---
import Logo from './Logo.astro';
import { CONTENT, ROUTES, other, type Locale, type PageKey } from '../config/site';

interface Props {
  lang: Locale;
  pageKey: PageKey;
  transparent?: boolean;
  /** Oculta el header arriba del todo (cuando el hero trae su propio menú) y lo muestra al hacer scroll. */
  hideAtTop?: boolean;
}
const { lang, pageKey, transparent = false, hideAtTop = false } = Astro.props;
const t = CONTENT[lang];
const r = ROUTES[lang];

const nav: { label: string; href: string; key: PageKey }[] = [
  { label: t.nav.home, href: r.home, key: 'home' },
  { label: t.nav.portfolio, href: r.portfolio, key: 'portfolio' },
  { label: t.nav.about, href: r.about, key: 'about' },
  { label: t.nav.contact, href: r.contact, key: 'contact' },
];
const altLang = other(lang);
const altHref = ROUTES[altLang][pageKey];
---

<header class:list={['site-header', { 'is-transparent': transparent, 'is-hide-top': hideAtTop }]} data-header>
  <div class="site-header__inner container">
    <a href={r.home} class="brand"><Logo /></a>

    <nav class="nav" aria-label="Navegación principal">
      {nav.map((item, i) => (
        <a href={item.href} class:list={['nav__link', { 'is-active': item.key === pageKey }]}>
          <span class="nav__num">{String(i + 1).padStart(2, '0')}</span>{item.label}
        </a>
      ))}
      <a href={altHref} class="nav__lang" hreflang={altLang} aria-label={`Cambiar idioma a ${altLang.toUpperCase()}`}>{t.langToggle}</a>
    </nav>

    <button class="nav-toggle" aria-label="Abrir menú" aria-expanded="false" data-toggle>
      <span></span><span></span>
    </button>
  </div>

  <div class="mobile-menu" data-mobile-menu hidden>
    <nav class="mobile-menu__nav" aria-label="Navegación móvil">
      {nav.map((item, i) => (
        <a href={item.href} class="mobile-menu__link"><span class="mono">{String(i + 1).padStart(2, '0')}</span> {item.label}</a>
      ))}
      <a href={altHref} class="mobile-menu__lang mono" hreflang={altLang}>{t.langToggle}</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.4s ease, border-color 0.4s ease, opacity 0.4s ease;
  }
  /* Oculto arriba del todo (el hero enmarcado trae su propio menú); aparece al hacer scroll */
  .site-header.is-hide-top:not(.is-scrolled) { opacity: 0; pointer-events: none; }
  .site-header__inner { display: flex; align-items: center; justify-content: space-between; height: 72px; }
  .brand { color: var(--ink); }

  .nav { display: flex; align-items: center; gap: clamp(1.2rem, 2.4vw, 2.4rem); }
  .nav__link {
    font-family: var(--font-mono);
    font-size: 0.72rem; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--ink); display: inline-flex; align-items: baseline; gap: 0.45em;
    position: relative; padding-block: 0.3rem;
  }
  .nav__num { font-size: 0.6rem; color: var(--maroon); }
  .nav__link::after {
    content: ''; position: absolute; left: 0; bottom: 0; width: 0; height: 1px;
    background: var(--maroon); transition: width 0.3s ease;
  }
  .nav__link:hover::after, .nav__link.is-active::after { width: 100%; }

  .nav__lang {
    font-family: var(--font-mono); font-size: 0.7rem; letter-spacing: 0.08em;
    color: var(--maroon); border: 1px solid var(--line); padding: 0.35em 0.7em;
  }
  .nav__lang:hover { background: var(--olive); color: var(--cream); border-color: var(--olive); }

  /* Transparente sobre el hero */
  .site-header.is-transparent { background: transparent; border-color: transparent; }
  .site-header.is-transparent .brand,
  .site-header.is-transparent .nav__link { color: var(--cream); }
  .site-header.is-transparent .nav__lang { color: var(--cream); border-color: rgba(250,246,238,0.5); }
  .site-header.is-transparent .nav-toggle span { background: var(--cream); }

  .site-header.is-transparent.is-scrolled { background: var(--cream); border-color: var(--line); }
  .site-header.is-transparent.is-scrolled .brand,
  .site-header.is-transparent.is-scrolled .nav__link { color: var(--ink); }
  .site-header.is-transparent.is-scrolled .nav__lang { color: var(--maroon); border-color: var(--line); }
  .site-header.is-transparent.is-scrolled .nav-toggle span { background: var(--ink); }

  .nav-toggle { display: none; flex-direction: column; gap: 6px; width: 30px; background: none; border: 0; cursor: pointer; padding: 4px; }
  .nav-toggle span { height: 1.5px; width: 100%; background: var(--ink); transition: transform 0.3s ease, opacity 0.3s ease; }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) { transform: translateY(3.75px) rotate(45deg); }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) { transform: translateY(-3.75px) rotate(-45deg); }

  .mobile-menu { position: fixed; inset: 72px 0 0 0; background: var(--olive); z-index: 40; display: grid; place-items: center; }
  .mobile-menu[hidden] { display: none; }
  .mobile-menu__nav { display: flex; flex-direction: column; align-items: center; gap: 1.4rem; }
  .mobile-menu__link { font-family: var(--font-display); font-style: italic; font-size: 2.4rem; color: var(--cream); }
  .mobile-menu__link .mono { color: var(--beige); font-style: normal; font-size: 0.8rem; }
  .mobile-menu__lang { margin-top: 0.6rem; color: var(--beige); border: 1px solid rgba(250,246,238,0.5); padding: 0.5em 1.1em; }

  @media (max-width: 880px) {
    .nav { display: none; }
    .nav-toggle { display: flex; }
    .site-header.is-transparent { background: var(--cream); border-color: var(--line); }
    .site-header.is-transparent .brand { color: var(--ink); }
    .site-header.is-transparent .nav-toggle span { background: var(--ink); }
    /* En móvil el header fijo siempre es visible (la tarjeta oculta su menú propio) */
    .site-header.is-hide-top:not(.is-scrolled) { opacity: 1; pointer-events: auto; }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');
  const toggle = document.querySelector('[data-toggle]');
  const menu = document.querySelector('[data-mobile-menu]') as HTMLElement | null;
  if (header?.classList.contains('is-transparent')) {
    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 40);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
    document.body.style.overflow = open ? '' : 'hidden';
  });
</script>
