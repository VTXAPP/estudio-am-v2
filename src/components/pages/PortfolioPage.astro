---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../ContactCTA.astro';
import { CONTENT, PHOTOS, type Locale, type Category } from '../../config/site';

const { lang } = Astro.props as { lang: Locale };
const t = CONTENT[lang];

const filters: { key: 'all' | Category; label: string }[] = [
  { key: 'all', label: t.portfolio.filters.all },
  { key: 'bodas', label: t.portfolio.filters.bodas },
  { key: 'eventos', label: t.portfolio.filters.eventos },
  { key: 'retratos', label: t.portfolio.filters.retratos },
  { key: 'producto', label: t.portfolio.filters.producto },
];
const catLabel = (c: string) => (t.portfolio.filters as any)[c] ?? c;
---

<Base lang={lang} pageKey="portfolio" title={t.nav.portfolio}>
  <section class="p-head">
    <div class="container reveal">
      <span class="mono mono--maroon">✦ {t.portfolio.eyebrow}</span>
      <h1 class="display-xl p-head__title">{t.portfolio.title}</h1>
      <p class="lead p-head__lead">{t.portfolio.lead}</p>

      <div class="filters" role="tablist" aria-label={t.portfolio.eyebrow}>
        {filters.map((f, i) => (
          <button class:list={['filter mono', { 'is-active': i === 0 }]} data-filter={f.key} type="button">{f.label}</button>
        ))}
      </div>
    </div>
  </section>

  <section class="p-grid-wrap">
    <div class="container">
      <div class="p-grid" data-grid>
        {PHOTOS.map((img, i) => (
          <figure class="p-item reveal" data-cat={img.cat} data-index={i}>
            <div class="p-item__img">
              <Image src={img.src} alt={img.alt[lang]} widths={[500, 900, 1400]} sizes="(max-width: 520px) 100vw, (max-width: 820px) 50vw, 33vw" loading={i < 3 ? 'eager' : 'lazy'} />
            </div>
            <figcaption class="mono p-cap">
              <span>Fig. {String(i + 1).padStart(2, '0')}</span>
              <span>{catLabel(img.cat)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} />

  <div class="lightbox" data-lightbox hidden>
    <button class="lightbox__close mono" data-lb-close aria-label="Cerrar / Close">Cerrar ×</button>
    <button class="lightbox__nav lightbox__nav--prev" data-lb-prev aria-label="Anterior / Previous">‹</button>
    <img class="lightbox__img" data-lb-img src="" alt="" />
    <button class="lightbox__nav lightbox__nav--next" data-lb-next aria-label="Siguiente / Next">›</button>
  </div>
</Base>

<style>
  .p-head { padding-top: calc(72px + clamp(3rem, 7vw, 7rem)); padding-bottom: clamp(2rem, 4vw, 3rem); background: var(--cream); }
  .p-head__title { margin: 0.6rem 0 1.25rem; }
  .p-head__lead { max-width: 52ch; }

  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 2.25rem; }
  .filter {
    color: var(--ink-soft); background: none; border: 1px solid var(--line); border-radius: 0;
    padding: 0.65em 1.2em; cursor: pointer; transition: all 0.3s ease;
  }
  .filter:hover { color: var(--ink); border-color: var(--ink); }
  .filter.is-active { background: var(--olive); color: var(--cream); border-color: var(--olive); }

  .p-grid-wrap { padding-block: clamp(2.5rem, 5vw, 5rem); background: var(--cream); }
  .p-grid { columns: 3; column-gap: clamp(1rem, 2vw, 2rem); }
  .p-item { break-inside: avoid; margin-bottom: clamp(1.5rem, 3vw, 3rem); cursor: zoom-in; }
  .p-item.is-hidden { display: none; }
  .p-item__img { overflow: hidden; }
  .p-item__img img { width: 100%; filter: grayscale(1); transition: transform 0.7s ease, filter 0.6s ease; }
  .p-item:hover .p-item__img img { transform: scale(1.04); filter: grayscale(0); }
  .p-cap { display: flex; justify-content: space-between; margin-top: 0.6rem; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 0.5rem; }

  @media (max-width: 820px) { .p-grid { columns: 2; } }
  @media (max-width: 520px) { .p-grid { columns: 1; } }

  .lightbox { position: fixed; inset: 0; z-index: 100; background: rgba(40, 34, 18, 0.96); display: grid; place-items: center; padding: clamp(1rem, 4vw, 3rem); }
  .lightbox[hidden] { display: none; }
  .lightbox__img { max-width: min(92vw, 1100px); max-height: 84vh; object-fit: contain; box-shadow: 0 30px 80px rgba(0,0,0,0.5); }
  .lightbox__close { position: absolute; top: clamp(1rem,3vw,2rem); right: clamp(1rem,3vw,2rem); background: none; border: 0; color: var(--cream); cursor: pointer; }
  .lightbox__nav { position: absolute; background: none; border: 0; color: var(--cream); cursor: pointer; line-height: 1; font-size: 3rem; top: 50%; transform: translateY(-50%); padding: 0 1rem; transition: opacity 0.2s ease; }
  .lightbox__nav--prev { left: clamp(0.25rem,2vw,1.5rem); }
  .lightbox__nav--next { right: clamp(0.25rem,2vw,1.5rem); }
  .lightbox__close:hover, .lightbox__nav:hover { opacity: 0.6; }
</style>

<script>
  const buttons = Array.from(document.querySelectorAll('[data-filter]')) as HTMLButtonElement[];
  const allItems = Array.from(document.querySelectorAll('.p-item')) as HTMLElement[];

  function applyFilter(cat: string) {
    allItems.forEach((it) => {
      const show = cat === 'all' || it.dataset.cat === cat;
      it.classList.toggle('is-hidden', !show);
    });
  }
  function selectFilter(cat: string, updateUrl = true) {
    const btn = buttons.find((b) => b.dataset.filter === cat);
    if (!btn) return;
    buttons.forEach((x) => x.classList.remove('is-active'));
    btn.classList.add('is-active');
    applyFilter(cat);
    if (updateUrl) {
      const url = new URL(window.location.href);
      if (cat === 'all') url.searchParams.delete('cat');
      else url.searchParams.set('cat', cat);
      history.replaceState(null, '', url);
    }
  }

  buttons.forEach((b) => b.addEventListener('click', () => selectFilter(b.dataset.filter || 'all')));

  /* Categoría inicial vía ?cat= (p. ej. al llegar desde "Trabajos recientes") */
  const initial = new URLSearchParams(window.location.search).get('cat');
  if (initial && buttons.some((b) => b.dataset.filter === initial)) selectFilter(initial, false);

  const lb = document.querySelector('[data-lightbox]') as HTMLElement | null;
  const lbImg = document.querySelector('[data-lb-img]') as HTMLImageElement | null;
  let visible: HTMLImageElement[] = [];
  let current = 0;

  function refreshVisible() {
    visible = allItems.filter((it) => !it.classList.contains('is-hidden'))
      .map((it) => it.querySelector('img') as HTMLImageElement);
  }
  function show(i: number) {
    if (!lb || !lbImg) return;
    refreshVisible();
    if (!visible.length) return;
    current = (i + visible.length) % visible.length;
    const img = visible[current];
    lbImg.src = img.currentSrc || img.src;
    lbImg.alt = img.alt;
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function close() { if (lb) { lb.hidden = true; document.body.style.overflow = ''; } }

  allItems.forEach((it) => it.addEventListener('click', () => {
    refreshVisible();
    const img = it.querySelector('img') as HTMLImageElement;
    show(visible.indexOf(img));
  }));
  document.querySelector('[data-lb-close]')?.addEventListener('click', close);
  document.querySelector('[data-lb-next]')?.addEventListener('click', () => show(current + 1));
  document.querySelector('[data-lb-prev]')?.addEventListener('click', () => show(current - 1));
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });
  document.addEventListener('keydown', (e) => {
    if (lb?.hidden) return;
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowRight') show(current + 1);
    if (e.key === 'ArrowLeft') show(current - 1);
  });
</script>
