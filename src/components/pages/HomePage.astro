---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../ContactCTA.astro';
import { CONTENT, ROUTES, IMG, PHOTOS, type Locale, type PageKey } from '../../config/site';

const { lang } = Astro.props as { lang: Locale };
const t = CONTENT[lang];
const r = ROUTES[lang];
const featured = PHOTOS.filter((p) => p.feat).slice(0, 6);
const catLabel = (c: string) => (t.portfolio.filters as any)[c] ?? c;

const marqueeWords = lang === 'es'
  ? ['Bodas', 'Eventos', 'Retratos', 'Estudio AM', 'Fotografía']
  : ['Weddings', 'Events', 'Portraits', 'Estudio AM', 'Photography'];

/* Menú dentro de la tarjeta del hero (estilo referencia: mono, granate, subrayado) */
const cardNav: { label: string; href: string; key: PageKey }[] = [
  { label: t.nav.portfolio, href: r.portfolio, key: 'portfolio' },
  { label: t.nav.about, href: r.about, key: 'about' },
  { label: t.nav.contact, href: r.contact, key: 'contact' },
];
const year = new Date().getFullYear();
---

<Base lang={lang} pageKey="home" transparentHeader={true} hideHeaderAtTop={true}>
  <!-- HERO enmarcado: mat granate + tarjeta crema + foto pequeña + flor dibujada -->
  <section class="fhero">
    <div class="fhero__card">
      <div class="fhero__top">
        <a href={r.home} class="fhero__brand" aria-label="Estudio AM">
          <span class="fhero__title">ESTUDIO AM</span>
        </a>
        <nav class="fhero__nav" aria-label="Navegación">
          {cardNav.map((item) => <a href={item.href} class="mono fhero__link">{item.label}</a>)}
          <a href={ROUTES[lang === 'es' ? 'en' : 'es'].home} class="mono fhero__link fhero__link--lang" hreflang={lang === 'es' ? 'en' : 'es'}>{t.langToggle}</a>
        </nav>
      </div>

      <figure class="fhero__photo">
        <Image
          src={IMG.am24}
          alt={lang === 'es' ? 'Cola del vestido de novia de tul, en blanco y negro' : 'Bride’s tulle dress train, black and white'}
          widths={[240, 420, 640]}
          sizes="(max-width: 760px) 46vw, 22vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <!-- Flor de trazo a mano (granate) -->
      <svg class="fhero__flower" viewBox="0 0 1000 560" fill="none" aria-hidden="true" preserveAspectRatio="xMidYMax meet">
        <g stroke="var(--brick)" stroke-linecap="round" stroke-linejoin="round" fill="none">
          <!-- tallo largo que sale por abajo de la tarjeta -->
          <path stroke-width="7" d="M296 350 C 292 420, 304 500, 330 590" />
          <!-- tallo que conecta con la flor derecha -->
          <path stroke-width="7" d="M302 344 C 352 424, 462 458, 566 434 C 628 419, 666 384, 696 340" />
          <!-- hoja abierta sobre el tallo -->
          <path stroke-width="6.5" d="M540 444 C 560 408, 596 396, 618 400 C 600 424, 566 438, 544 446" />
          <!-- flor izquierda: pétalos abiertos y puntiagudos (trazo fino) -->
          <path stroke-width="6.5" d="M298 326 C 262 300, 218 258, 202 218 C 238 238, 282 294, 304 324" />
          <path stroke-width="6.5" d="M302 320 C 292 272, 288 220, 302 178 C 322 220, 318 282, 308 322" />
          <path stroke-width="6.5" d="M310 326 C 344 292, 386 262, 424 250 C 402 292, 352 322, 314 334" />
          <path stroke-width="6.5" d="M314 340 C 356 352, 396 376, 416 408 C 372 400, 330 372, 310 348" />
          <path stroke-width="6.5" d="M304 348 C 306 396, 296 446, 272 482 C 262 436, 278 384, 296 350" />
          <path stroke-width="6.5" d="M292 340 C 252 352, 210 352, 178 338 C 214 320, 262 322, 292 332" />
          <path stroke-width="6.5" d="M290 326 c -5 -9, 9 -15, 14 -6 c 4 8, -7 14, -14 6" />
          <!-- flor derecha: pétalos anchos, trazo grueso tipo plumón -->
          <path stroke-width="13" d="M694 324 C 668 288, 646 254, 642 226 C 668 244, 692 288, 702 320" />
          <path stroke-width="13" d="M706 318 C 716 280, 736 246, 762 230 C 758 264, 736 300, 712 322" />
          <path stroke-width="13" d="M712 330 C 748 322, 786 320, 812 332 C 788 354, 748 356, 714 340" />
          <path stroke-width="13" d="M708 342 C 724 374, 736 410, 730 442 C 706 416, 698 376, 700 346" />
          <path stroke-width="13" d="M696 342 C 678 368, 652 392, 622 400 C 634 370, 664 348, 692 334" />
          <path stroke-width="10" d="M696 326 c -4 -8, 9 -13, 13 -5 c 3 7, -7 12, -13 5" />
        </g>
      </svg>

      <div class="fhero__bottom">
        <span class="mono fhero__foot">© {year} Estudio AM · {t.footerRights}</span>
        <a href={r.portfolio} class="mono fhero__foot fhero__foot--link">{t.hero.cta} ↓</a>
      </div>
    </div>
  </section>

  <!-- MARQUESINA -->
  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[...marqueeWords, ...marqueeWords].map((w) => <span>{w}</span>)}
    </div>
  </div>

  <!-- MANIFIESTO -->
  <section class="section manifesto">
    <div class="container manifesto__grid">
      <p class="mono mono--maroon reveal">✦ {lang === 'es' ? 'Manifiesto' : 'Statement'}</p>
      <p class="manifesto__text reveal">{t.intro}</p>
    </div>
  </section>

  <!-- TRABAJO SELECCIONADO -->
  <section class="section work">
    <div class="container">
      <div class="work__head reveal">
        <span class="mono">{t.featured.eyebrow}</span>
        <h2 class="display-lg">{t.featured.title}</h2>
      </div>
      <div class="work__grid">
        {featured.map((img, i) => (
          <figure class="work__fig reveal">
            <a href={r.portfolio} class="work__imgwrap">
              <Image src={img.src} alt={img.alt[lang]} widths={[500, 800, 1100]} sizes="(max-width: 760px) 100vw, 50vw" />
            </a>
            <figcaption class="mono work__cap">
              <span>Fig. {String(i + 1).padStart(2, '0')}</span>
              <span>{catLabel(img.cat)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      <a href={r.portfolio} class="work__more btn btn--outline">{lang === 'es' ? 'Ver portafolio completo' : 'See full portfolio'} →</a>
    </div>
  </section>

  <!-- NUESTRA MIRADA -->
  <section class="section approach">
    <div class="container approach__grid">
      <div class="approach__side">
        <span class="mono mono--maroon">✦ {t.approach.eyebrow}</span>
      </div>
      <div class="approach__main reveal">
        <h2 class="display-md approach__title">{t.approach.title}</h2>
        <div class="approach__cols">
          <p>{t.approach.col1}</p>
          <p>{t.approach.col2}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS (índice editorial) -->
  <section class="section services">
    <div class="container">
      <div class="work__head reveal">
        <span class="mono">{t.services.eyebrow}</span>
        <h2 class="display-lg">{t.services.title}</h2>
      </div>
      <ul class="svc">
        {t.services.items.map((s, i) => (
          <li class="svc__row reveal">
            <a href={r.contact} class="svc__link">
              <span class="mono svc__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__title">{s.title}</span>
              <span class="svc__text">{s.text}</span>
              <span class="mono svc__cta">{t.services.cta} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- TESTIMONIOS -->
  <section class="section kind">
    <div class="container">
      <span class="mono mono--maroon reveal">✦ {t.kindWords}</span>
      <div class="kind__grid">
        {t.testimonials.map((q, i) => (
          <blockquote class="kind__q reveal">
            <span class="mono kind__n">{String(i + 1).padStart(2, '0')}</span>
            <p class="kind__text">“{q.quote}”</p>
            <cite class="mono kind__by">— {q.author}</cite>
          </blockquote>
        ))}
      </div>
    </div>
  </section>

  <ContactCTA lang={lang} />
</Base>

<style>
  /* ---- HERO enmarcado (mat granate + tarjeta crema) ---- */
  .fhero {
    background: var(--brick);
    min-height: 100svh;
    display: grid;
    padding: clamp(1.1rem, 4.5vw, 4.5rem);
  }
  .fhero__card {
    position: relative;
    background: var(--cream);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.1rem, 2.6vw, 2.4rem);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }
  .fhero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 3;
  }
  .fhero__title {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    letter-spacing: 0.22em;
    color: var(--ink);
    white-space: nowrap;
  }
  .fhero__nav { display: flex; gap: clamp(0.9rem, 2vw, 1.8rem); align-items: center; }
  .fhero__link {
    color: var(--maroon);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }
  .fhero__link:hover { color: var(--maroon-deep); font-weight: 500; }
  .fhero__link--lang { border: 1px solid var(--line); padding: 0.3em 0.6em; text-decoration: none; }
  .fhero__link--lang:hover { background: var(--olive); color: var(--cream); border-color: var(--olive); }

  .fhero__photo {
    position: absolute;
    left: 50%;
    top: 42%;
    transform: translate(-50%, -50%);
    width: clamp(170px, 21vw, 260px);
    z-index: 1;
    margin: 0;
  }
  .fhero__photo img { width: 100%; filter: grayscale(1); }

  .fhero__flower {
    position: absolute;
    left: 4%;
    bottom: -7%;
    width: 82%;
    max-height: 82%;
    z-index: 2;
    pointer-events: none;
  }

  .fhero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    position: relative;
    z-index: 3;
  }
  .fhero__foot { color: var(--ink-soft); font-size: 0.62rem; }
  .fhero__foot--link { color: var(--maroon); }
  .fhero__foot--link:hover { text-decoration: underline; text-underline-offset: 0.35em; }

  @media (max-width: 880px) {
    /* el header fijo (con hamburguesa) queda visible: damos aire arriba y ocultamos el menú propio */
    .fhero { padding-top: calc(72px + 1.1rem); }
    .fhero__nav { display: none; }
    .fhero__photo { width: clamp(150px, 44vw, 220px); }
    .fhero__flower { width: 92%; left: 2%; }
  }

  /* ---- MANIFIESTO ---- */
  .manifesto { background: var(--cream); }
  .manifesto__grid { display: grid; grid-template-columns: 0.25fr 0.75fr; gap: 2rem; align-items: start; }
  .manifesto__text { font-family: var(--font-display); font-style: italic; font-weight: 400; font-size: clamp(1.7rem, 4vw, 3.4rem); line-height: 1.18; color: var(--ink); }

  /* ---- HEAD reutilizable ---- */
  .work__head { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: clamp(2rem, 5vw, 4rem); }

  /* ---- TRABAJO (rejilla editorial asimétrica) ---- */
  .work { background: var(--cream); }
  .work__grid { display: grid; grid-template-columns: repeat(12, 1fr); column-gap: clamp(1rem, 2.5vw, 2.5rem); }
  .work__fig { margin-bottom: clamp(2rem, 5vw, 4.5rem); }
  .work__fig:nth-child(odd) { grid-column: 1 / 8; }
  .work__fig:nth-child(even) { grid-column: 8 / 13; margin-top: clamp(2rem, 7vw, 7rem); }
  .work__imgwrap { display: block; overflow: hidden; }
  .work__imgwrap img { width: 100%; transition: transform 0.8s ease, filter 0.6s ease; }
  .work__fig:hover .work__imgwrap img { transform: scale(1.03); }
  .work__cap { display: flex; justify-content: space-between; margin-top: 0.7rem; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 0.6rem; }
  .work__more { margin-top: 1rem; }

  /* ---- NUESTRA MIRADA ---- */
  .approach { background: var(--beige-soft); }
  .approach__grid { display: grid; grid-template-columns: 0.25fr 0.75fr; gap: 2rem; }
  .approach__title { margin-bottom: 1.75rem; max-width: 16ch; }
  .approach__cols { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); }
  .approach__cols p { color: var(--ink-soft); max-width: 44ch; }

  /* ---- SERVICIOS ---- */
  .services { background: var(--cream); }
  .svc { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .svc__row { border-bottom: 1px solid var(--line); }
  .svc__link {
    display: grid; grid-template-columns: 3rem 1.1fr 1.6fr auto; gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline; padding-block: clamp(1.5rem, 3vw, 2.4rem);
    transition: padding-left 0.4s ease, background-color 0.4s ease;
  }
  .svc__link:hover { padding-left: 1rem; background: var(--beige-soft); }
  .svc__num { color: var(--maroon); }
  .svc__title { font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.2rem); line-height: 1; }
  .svc__link:hover .svc__title { font-style: italic; }
  .svc__text { color: var(--ink-soft); max-width: 46ch; }
  .svc__cta { color: var(--olive-soft); white-space: nowrap; }

  /* ---- TESTIMONIOS ---- */
  .kind { background: var(--sand); }
  .kind__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(1.5rem, 4vw, 3.5rem); margin-top: clamp(2rem, 4vw, 3.5rem); }
  .kind__q { display: flex; flex-direction: column; gap: 1rem; }
  .kind__n { color: var(--maroon); }
  .kind__text { font-family: var(--font-display); font-style: italic; font-size: clamp(1.2rem, 1.8vw, 1.6rem); line-height: 1.35; color: var(--ink); }
  .kind__by { color: var(--ink-soft); }

  @media (max-width: 900px) {
    .manifesto__grid, .approach__grid { grid-template-columns: 1fr; }
    .approach__cols { grid-template-columns: 1fr; }
    .svc__link { grid-template-columns: 2.2rem 1fr; row-gap: 0.5rem; }
    .svc__text, .svc__cta { grid-column: 2; }
    .kind__grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
  @media (max-width: 760px) {
    .work__fig:nth-child(odd), .work__fig:nth-child(even) { grid-column: 1 / 13; margin-top: 0; }
  }
</style>
