---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ContactCTA from '../ContactCTA.astro';
import { CONTENT, ROUTES, type Locale, type PageKey } from '../../config/site';
import amCover from '../../assets/am-cover.jpg';   // foto de portada (velo, B&N) — la del mock
import florMock from '../../assets/flor-mock.png'; // flores EXACTAS extraídas del mock (#873834)
import amFull from '../../assets/am-full.jpg';     // fotografía completa bajo la portada (cena de evento, B&N)
import amMomento from '../../assets/am-23.jpg';    // sección "momento": novia en la silla del jardín, B&N (era la Fig 05 de "Trabajos recientes")

const { lang } = Astro.props as { lang: Locale };
const t = CONTENT[lang];
const r = ROUTES[lang];

/* Menú dentro de la tarjeta (como el mock: dos enlaces arriba a la derecha) */
const cardNav: { label: string; href: string; key: PageKey }[] = [
  { label: t.nav.portfolio, href: r.portfolio, key: 'portfolio' },
  { label: t.nav.contact, href: r.contact, key: 'contact' },
];
/* Menú superior centrado sobre el mat */
const topNav: { label: string; href: string }[] = [
  { label: t.nav.home, href: r.home },
  { label: t.nav.portfolio, href: r.portfolio },
  { label: t.services.eyebrow, href: `${r.home}#servicios` },
  { label: t.nav.about, href: r.about },
  { label: t.nav.contact, href: r.contact },
];
const year = new Date().getFullYear();
---

<Base lang={lang} pageKey="home" transparentHeader={true} hideHeaderAtTop={true}>
  <!-- HERO enmarcado (geometría medida del mock: márgenes 22.3/19.9/27.2/21.4%) -->
  <section class="fhero">
    <nav class="fhero__topnav" aria-label="Navegación principal">
      {topNav.map((item) => <a href={item.href} class="mono fhero__vlink">{item.label}</a>)}
    </nav>

    <div class="fhero__card">
      <div class="fhero__top">
        <a href={r.home} class="fhero__brand" aria-label="Estudio AM">
          <span class="fhero__title">ESTUDIO AM</span>
        </a>
        <nav class="fhero__nav" aria-label="Navegación">
          {cardNav.map((item) => <a href={item.href} class="mono fhero__link">{item.label}</a>)}
          <a href={ROUTES[lang === 'es' ? 'en' : 'es'].home} class="mono fhero__link fhero__link--lang" hreflang={lang === 'es' ? 'en' : 'es'}>{t.langToggle}</a>
        </nav>
      </div>

      <figure class="fhero__photo">
        <Image
          src={amCover}
          alt={lang === 'es' ? 'Velo de novia cayendo sobre una banca, en blanco y negro' : 'Bridal veil draped over a bench, black and white'}
          widths={[240, 420, 640]}
          sizes="(max-width: 880px) 40vw, 12vw"
          loading="eager"
          fetchpriority="high"
        />
      </figure>

      <!-- Flores exactas del mock (PNG con transparencia, tintado #873834) -->
      <Image src={florMock} alt="" widths={[640, 1192]} sizes="(max-width: 880px) 84vw, 38vw" class="fhero__flower" loading="eager" aria-hidden="true" />

      <div class="fhero__bottom">
        <span class="mono fhero__foot">© {year} Estudio AM · {t.footerRights}</span>
      </div>
    </div>
  </section>

  <!-- FOTOGRAFÍA COMPLETA (a todo lo ancho, sin recorte) -->
  <section class="fullphoto">
    <Image
      src={amFull}
      alt={lang === 'es' ? 'Mesa de cena durante un evento, con copas e invitados alrededor, en blanco y negro' : 'Dinner table during an event, with glasses and guests around, in black and white'}
      widths={[768, 1366, 2000, 2600]}
      sizes="100vw"
      loading="lazy"
    />
  </section>

  <!-- MOMENTO: foto + frase caligráfica a mano (frase = PLACEHOLDER, sustituir por la definitiva) -->
  <section class="section momento">
    <div class="container momento__grid">
      <figure class="momento__photo reveal">
        <Image
          src={amMomento}
          alt={lang === 'es' ? 'Novia de espaldas con vestido de tul y cola larga apoyada en una silla en un jardín, en blanco y negro' : 'Bride seen from behind in a tulle gown with a long train, leaning on a chair in a garden, black and white'}
          widths={[500, 800, 1100]}
          sizes="(max-width: 880px) 100vw, 48vw"
          loading="lazy"
        />
      </figure>
      <p class="momento__frase reveal">
        {lang === 'es' ? 'donde cada historia se moldea con intención' : 'where every story is shaped by intention'}
      </p>
    </div>
  </section>

  <!-- SERVICIOS (índice editorial) -->
  <section class="section services" id="servicios">
    <div class="container">
      <div class="work__head reveal">
        <h2 class="display-lg">{t.services.eyebrow}</h2>
      </div>
      <ul class="svc">
        {t.services.items.map((s, i) => (
          <li class="svc__row reveal">
            <a href={r.contact} class="svc__link">
              <span class="mono svc__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="svc__title">{s.title}</span>
              <span class="mono svc__cta">{t.services.cta} →</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <ContactCTA lang={lang} />
</Base>

<style>
  /* ---- HERO enmarcado — geometría del mock ---- */
  .fhero {
    position: relative;
    background: var(--brick);
    min-height: 100svh;
    display: grid;
    /* márgenes medidos del mock: T 27.2% · R 19.9% · B 21.4% · L 22.3% */
    padding: 27.2svh 19.9vw 21.4svh 22.3vw;
  }
  /* menú superior centrado sobre el mat */
  .fhero__topnav {
    position: absolute;
    top: 13.5svh;
    left: 0; right: 0;
    transform: translateY(-50%);
    display: flex;
    justify-content: center;
    align-items: center;
    gap: clamp(1.5rem, 3.5vw, 3.5rem);
    z-index: 2;
  }
  .fhero__vlink {
    font-size: clamp(0.85rem, 1vw, 1rem);
    letter-spacing: 0.2em;
    color: rgba(250, 246, 238, 0.92);
    white-space: nowrap;
  }
  .fhero__vlink:hover { color: var(--cream); text-decoration: underline; text-underline-offset: 0.4em; }

  .fhero__card {
    position: relative;
    background: var(--cream);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(0.85rem, 1.5vw, 1.5rem) clamp(0.9rem, 1.6vw, 1.7rem);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.28);
  }
  .fhero__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
    z-index: 3;
  }
  .fhero__title {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: clamp(0.9rem, 1vw, 1.15rem);
    letter-spacing: 0.16em;
    color: var(--ink);
    white-space: nowrap;
  }
  .fhero__nav { display: flex; gap: clamp(0.9rem, 1.6vw, 1.5rem); align-items: center; }
  .fhero__link {
    color: var(--brick);
    text-decoration: underline;
    text-underline-offset: 0.35em;
    text-decoration-thickness: 1px;
  }
  .fhero__link:hover { color: var(--maroon-deep); font-weight: 500; }
  .fhero__link--lang { border: 1px solid var(--line); padding: 0.3em 0.6em; text-decoration: none; }
  .fhero__link--lang:hover { background: var(--olive); color: var(--cream); border-color: var(--olive); }

  /* foto: medida del mock — left 42.8% · top 9% · ancho 19.35% · ratio 179/235 */
  .fhero__photo {
    position: absolute;
    left: 42.8%;
    top: 8.95%;
    width: 19.35%;
    aspect-ratio: 179 / 235;
    z-index: 1;
    margin: 0;
  }
  .fhero__photo img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0%; filter: grayscale(1); }

  /* flores exactas del mock: left 16.5% · pegadas abajo · ancho 64.4% */
  .fhero__flower {
    position: absolute;
    left: 16.5%;
    bottom: 0.3%;
    width: 64.4%;
    height: auto;
    z-index: 2;
    pointer-events: none;
  }

  .fhero__bottom { display: flex; justify-content: flex-start; position: relative; z-index: 3; }
  .fhero__foot { color: var(--ink-soft); font-size: 0.6rem; }

  @media (max-width: 1100px) {
    .fhero { padding: 16svh 9vw 12svh 11vw; }
    .fhero__topnav { top: 8svh; }
  }
  @media (max-width: 880px) {
    /* móvil: header fijo visible (hamburguesa); sin menú superior ni de tarjeta */
    .fhero { padding: calc(72px + 1rem) 1.1rem 1.4rem; }
    .fhero__topnav, .fhero__nav { display: none; }
    .fhero__card { min-height: calc(100svh - 72px - 2.4rem); }
    .fhero__photo { left: 30%; top: 10%; width: 40%; }
    .fhero__flower { left: 6%; width: 86%; }
  }

  /* ---- FOTOGRAFÍA COMPLETA ---- */
  .fullphoto { background: var(--cream); font-size: 0; }
  .fullphoto img { width: 100%; height: auto; display: block; }

  /* ---- HEAD reutilizable ---- */
  .work__head { display: flex; flex-direction: column; gap: 0.5rem; margin-bottom: clamp(2rem, 5vw, 4rem); }

  /* ---- MOMENTO (foto + frase caligráfica, como las flores de la portada) ---- */
  .momento { background: var(--cream); }
  .momento__grid {
    display: grid; grid-template-columns: 7fr 5fr;
    gap: clamp(2rem, 5vw, 5rem); align-items: center;
  }
  .momento__photo img { width: 100%; }
  .momento__frase {
    font-family: 'Caveat', cursive;
    color: var(--brick);
    font-size: clamp(2.6rem, 4.6vw, 4.4rem);
    line-height: 1.2;
    transform: rotate(-2.5deg);
  }

  /* ---- SERVICIOS ---- */
  .services { background: var(--cream); }
  .svc { list-style: none; padding: 0; border-top: 1px solid var(--line); }
  .svc__row { border-bottom: 1px solid var(--line); }
  .svc__link {
    display: grid; grid-template-columns: 3rem 1fr auto; gap: clamp(1rem, 3vw, 3rem);
    align-items: baseline; padding-block: clamp(1.5rem, 3vw, 2.4rem);
    transition: padding-left 0.4s ease, background-color 0.4s ease;
  }
  .svc__link:hover { padding-left: 1rem; background: var(--beige-soft); }
  .svc__num { color: var(--maroon); }
  .svc__title { font-family: var(--font-display); font-weight: 300; font-size: clamp(1.6rem, 3.4vw, 2.7rem); line-height: 1.08; }
  .svc__link:hover .svc__title { font-style: italic; }
  .svc__cta { color: var(--olive-soft); white-space: nowrap; }

  @media (max-width: 900px) {
    .svc__link { grid-template-columns: 2.2rem 1fr; row-gap: 0.5rem; }
    .svc__cta { grid-column: 2; }
  }
  @media (max-width: 880px) {
    .momento__grid { grid-template-columns: 1fr; }
    .momento__frase { transform: rotate(-2.5deg) translateY(-0.5rem); text-align: center; }
  }
</style>
