---
import { CONTENT, SITE, links, type Locale } from '../config/site';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const t = CONTENT[lang];
const l = links(lang);
---

<section class="cta section">
  <div class="container">
    <h2 class="display-lg cta__title reveal">{t.cta.eyebrow}</h2>

    <div class="cta__row reveal">
      <p class="cta__text">{t.cta.text}</p>
      <div class="cta__actions">
        <a href={l.whatsapp} target="_blank" rel="noopener" class="btn btn--solid">WhatsApp →</a>
        <a href={l.email} class="btn btn--light">{t.contact.emailLabel} →</a>
        <a href={l.instagram} target="_blank" rel="noopener" class="btn btn--light">Instagram →</a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Mismo granate de la portada; se une visualmente con el pie de página */
  .cta {
    background: var(--brick); color: var(--cream);
    position: relative; z-index: 2;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
  }
  .cta__title { color: var(--cream); }
  .cta__row {
    display: grid; grid-template-columns: 1fr 1fr;
    gap: clamp(1.5rem, 4vw, 4rem); align-items: end;
    margin-top: clamp(1rem, 2vw, 1.75rem);
    border-top: 1px solid rgba(250,246,238,0.28); padding-top: 2rem;
  }
  .cta__text { color: var(--beige); max-width: 44ch; }
  .cta__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; justify-content: flex-start; }

  /* Sobre el granate, el botón principal va en crema para que destaque */
  .cta__actions :global(.btn--solid) {
    background: var(--cream); color: var(--brick); border-color: var(--cream);
  }
  .cta__actions :global(.btn--solid:hover) { background: var(--beige); border-color: var(--beige); }

  @media (max-width: 760px) {
    .cta__row { grid-template-columns: 1fr; align-items: start; }
  }
</style>
